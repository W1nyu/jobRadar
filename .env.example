# jobRadar 환경변수
#
# 사용법: cp .env.example .env 후 값을 채운다. .env는 절대 커밋하지 않는다.
#
# [M1] 표시가 없는 항목은 해당 마일스톤에서 활성화된다. 지금 비워둬도 앱은 기동한다.
# 외부 API 키는 전부 선택값이다 — 키가 없으면 그 소스만 꺼지고 나머지는 정상 동작한다.
# 값은 `KEY=값` 형식으로만 적는다. 설명은 반드시 앞 줄에 두어 systemd 등 다른 로더와도 호환한다.

# =====================================================================
# 앱 [M1]
# =====================================================================
# development | production
APP_ENV=development
# 운영에서는 https://<도메인>
APP_BASE_URL=http://127.0.0.1:8000
# 세션 쿠키 서명. `openssl rand -hex 32`
SECRET_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 운영에서는 true (journald 수집용)
LOG_JSON=false

# =====================================================================
# 외부 API 키 [M3 / M7]
# =====================================================================
# 공공데이터포털 공용 키 (잡알리오 등) — M7에서 사용
DATA_GO_KR_SERVICE_KEY=

# 과기정통부 모집채용 API 전용 키 — M3에서 사용
MSIT_RECRUITMENT_SERVICE_KEY=

# 고용24 채용정보 API의 authKey — M3에서 사용
WORK24_SERVICE_KEY=

# 잡알리오 공공기관 채용정보 — 별도 활용신청. M7에서 소스로 추가
ALIO_SERVICE_KEY=

# 사람인 채용정보 API — 승인 절차 필요, 일 500건. M7에서 사용
#
#   승인 대기 중이면 비워둔다. 앱은 정상 기동하고 saramin_enabled 가 False가 된다.
#   승인이 나면 이 줄에 키를 채우고 앱을 재시작하는 것만으로 켜진다. 코드 변경 불필요.
#   확인: uv run python -m app.cli check-keys
SARAMIN_ACCESS_KEY=

# =====================================================================
# 데이터베이스 [M2]
# =====================================================================
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@127.0.0.1:5432/jobradar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# =====================================================================
# 수집 [M3 / M6]
# =====================================================================
CRAWL_MAX_WORKERS=3
CRAWL_MAX_ITEMS_PER_RUN=500
CRAWL_MAX_PAGES_PER_RUN=10
CRAWL_MAX_RESPONSE_BYTES=5242880
CRAWL_USER_AGENT=jobRadar/1.0 (personal job monitor; contact@example.com)
SOURCE_FAILURE_THRESHOLD=5
COLLECTION_DROP_RATIO=0.8

# =====================================================================
# 관리자 인증 [M8]
# =====================================================================
ADMIN_USERNAME=admin
# argon2 해시. 평문 비밀번호를 넣지 않는다.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_MAX_AGE_SECONDS=43200

# =====================================================================
# 알림 [M9]
# =====================================================================
# `generate-fernet` 출력값. 카카오 토큰 암호화 키
FERNET_KEY=
KAKAO_REST_API_KEY=
# 카카오 앱에서 Client Secret을 켠 경우
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<도메인>/oauth/kakao/callback
# `generate-vapid` 출력값
VAPID_PUBLIC_KEY=
# `generate-vapid` 출력값. 절대 커밋하지 않는다.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00
TIMEZONE=Asia/Seoul
# 매일 09:00 KST 자동 요약에 포함할 최근 공고 범위(24시간)
NOTIFICATION_LOOKBACK_MINUTES=1440
