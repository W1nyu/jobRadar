[Unit]
Description=jobRadar 수집·알림 워커
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=jobradar
Group=jobradar
WorkingDirectory=/opt/jobradar
EnvironmentFile=/opt/jobradar/.env
ExecStart=/opt/jobradar/.venv/bin/python -m app.worker.main
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
MemoryHigh=250M
MemoryMax=300M
OOMPolicy=continue
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/jobradar
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
